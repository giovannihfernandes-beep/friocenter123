<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FrioCenter Pescados — Catálogo de Fotos</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap');
:root{
  --bg:#081428;--surface:#0F2545;--surface-2:#153057;--line:#284B79;
  --text:#F3F6FA;--muted:#93A9C8;--gold:#FFC607;--gold-soft:#3D2E05;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;padding:40px 24px 80px;min-height:100vh}
.wrap{max-width:1080px;margin:0 auto;position:relative;z-index:1}
.bg-art{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;overflow:hidden}
.bg-art svg{position:absolute;color:var(--gold);opacity:0.05}
header{margin-bottom:32px}
.brand-row{display:flex;align-items:center;gap:12px;margin-bottom:14px}
.brand-logo{width:40px;height:40px;border-radius:50%;object-fit:cover;box-shadow:0 0 0 2px var(--gold)}
.eyebrow{font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:10px}
h1{font-family:'Fraunces',serif;font-weight:600;font-size:clamp(26px,4vw,38px);margin:0 0 8px}
.subtitle{color:var(--muted);font-size:15px;max-width:620px;line-height:1.5}
.mode-toggle{display:flex;gap:8px;margin-top:24px;flex-wrap:wrap}
.mode-toggle button{font-family:'IBM Plex Mono',monospace;font-size:13px;background:var(--surface);border:1px solid var(--line);color:var(--muted);padding:9px 16px;border-radius:8px;cursor:pointer;transition:all .15s}
.mode-toggle button:hover{color:var(--text);border-color:#3a5a8a}
.mode-toggle button.active{background:var(--gold);color:#0A1730;border-color:var(--gold);font-weight:600}
.panel{display:none}.panel.active{display:block}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin:24px 0}
.stat{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:16px 18px}
.stat .n{font-family:'IBM Plex Mono',monospace;font-size:28px;font-weight:600;color:var(--gold)}
.stat .l{font-size:12px;color:var(--muted);margin-top:4px}
.section-title{font-family:'Fraunces',serif;font-size:20px;font-weight:600;margin:32px 0 4px}
.section-sub{color:var(--muted);font-size:13px;margin-bottom:18px}
.controls{display:flex;gap:10px;margin-bottom:20px;flex-wrap:wrap}
.controls input{flex:1;min-width:200px;background:var(--surface);border:1px solid var(--line);color:var(--text);padding:10px 14px;border-radius:8px;font-size:14px;font-family:'Inter',sans-serif}
.controls input::placeholder{color:var(--muted)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;overflow:hidden;cursor:pointer;transition:border-color .15s,transform .15s}
.card:hover{border-color:#4a6080;transform:translateY(-2px)}
.card img{width:100%;height:180px;object-fit:cover;background:#0a1e3d;display:block}
.card .no-img{width:100%;height:180px;background:var(--surface-2);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:8px;color:var(--muted);font-size:13px}
.card-body{padding:14px}
.card-code{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.08em;color:var(--gold);margin-bottom:4px}
.card-name{font-size:13px;font-weight:500;line-height:1.4}
.card-hint{margin-top:8px;font-size:11px;color:var(--muted)}
.empty{text-align:center;color:var(--muted);padding:48px;font-size:14px}
.form-card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:24px;margin-bottom:24px}
.form-row{margin-bottom:14px}
.form-row label{display:block;font-size:11px;font-family:'IBM Plex Mono',monospace;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:6px}
.form-row input{width:100%;background:var(--surface-2);border:1px solid var(--line);color:var(--text);padding:10px 14px;border-radius:8px;font-size:14px;font-family:'Inter',sans-serif}
.form-row input::placeholder{color:var(--muted)}
.drop{border:1.5px dashed var(--line);border-radius:10px;padding:28px;text-align:center;cursor:pointer;color:var(--muted);font-size:14px;transition:border-color .15s;position:relative;display:flex;flex-direction:column;align-items:center;gap:10px;margin-top:6px}
.drop:hover,.drop.drag{border-color:var(--gold)}
.drop input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%}
.drop-thumb{width:80px;height:80px;object-fit:cover;border-radius:8px;border:1px solid var(--line);display:none}
.btn-add{width:100%;padding:11px;border-radius:8px;border:none;background:var(--gold);color:#0A1730;font-size:14px;font-weight:700;cursor:pointer;font-family:'IBM Plex Mono',monospace;margin-top:6px;transition:opacity .15s}
.btn-add:hover{opacity:.85}
.admin-list{display:flex;flex-direction:column;gap:8px}
.admin-row{display:grid;grid-template-columns:56px 1fr auto;align-items:center;gap:12px;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:10px 14px}
.admin-row img{width:48px;height:48px;object-fit:cover;border-radius:6px}
.admin-row .no-thumb{width:48px;height:48px;border-radius:6px;background:var(--surface-2);display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:20px}
.admin-info .c{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--gold)}
.admin-info .nm{font-size:13px;margin-top:2px}
.btn-del{background:none;border:none;cursor:pointer;color:var(--muted);font-size:18px;padding:4px;transition:color .15s;line-height:1}
.btn-del:hover{color:#EF4C4C}
.alert{padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:12px}
.alert.ok{background:#0F3324;color:#3DDC7A;border:1px solid #1a4d30}
.alert.err{background:#3A1D1D;color:#EF4C4C;border:1px solid #5a2a2a}
.search-hero{background:linear-gradient(135deg,var(--gold-soft),var(--surface) 60%);border:1px solid var(--line);border-radius:16px;padding:28px;margin-bottom:24px}
.search-hero h2{font-family:'Fraunces',serif;font-size:22px;font-weight:600;margin-bottom:8px}
.search-hero p{color:var(--muted);font-size:14px;margin-bottom:16px}
.search-row{display:flex;gap:10px}
.search-row input{flex:1;background:var(--surface-2);border:1px solid var(--line);color:var(--text);padding:11px 14px;border-radius:8px;font-family:'IBM Plex Mono',monospace;font-size:14px}
.search-row input::placeholder{color:var(--muted)}
.btn-search{padding:11px 20px;border-radius:8px;border:1px solid var(--gold);background:none;color:var(--gold);font-size:13px;font-weight:600;cursor:pointer;font-family:'IBM Plex Mono',monospace;transition:all .15s;white-space:nowrap}
.btn-search:hover{background:var(--gold);color:#0A1730}
.modal-overlay{position:fixed;inset:0;background:rgba(4,8,20,.85);backdrop-filter:blur(4px);display:none;align-items:center;justify-content:center;padding:20px;z-index:100}
.modal-overlay.open{display:flex}
.modal{background:var(--surface);border:1px solid var(--line);border-radius:16px;max-width:520px;width:100%;overflow:hidden;box-shadow:0 24px 64px rgba(0,0,0,.6)}
.modal-img{width:100%;max-height:300px;object-fit:contain;background:#060f1e;display:block}
.modal-body{padding:22px 24px 28px}
.modal-code{font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--gold);margin-bottom:4px}
.modal-name{font-family:'Fraunces',serif;font-size:20px;font-weight:600;margin-bottom:18px;line-height:1.3}
.btn-dl{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:13px;border-radius:8px;border:none;background:var(--gold);color:#0A1730;font-size:14px;font-weight:700;cursor:pointer;font-family:'IBM Plex Mono',monospace;transition:opacity .15s;text-decoration:none}
.btn-dl:hover{opacity:.85}
.btn-close{display:block;width:100%;margin-top:10px;padding:10px;border-radius:8px;border:1px solid var(--line);background:none;color:var(--muted);font-size:13px;cursor:pointer;font-family:'IBM Plex Mono',monospace;transition:all .15s}
.btn-close:hover{color:var(--text);border-color:#4a6080}
footer{margin-top:50px;color:var(--muted);font-size:12px;line-height:1.6;border-top:1px solid var(--line);padding-top:18px}
@media(max-width:600px){
  .grid{grid-template-columns:repeat(auto-fill,minmax(160px,1fr))}
  .search-row{flex-direction:column}
}
</style>
</head>
<body>
<div class="bg-art">
  <svg viewBox="0 0 28 24" style="width:240px;top:-30px;left:-50px;transform:rotate(-8deg)" fill="none" stroke="currentColor" stroke-width="1"><path d="M5 12c0-4.5 5-8 12-8 5 0 8.5 3 10 8-1.5 5-5 8-10 8-7 0-12-3.5-12-8z"/><path d="M5 12 1 7v10z"/><circle cx="21" cy="10" r=".9" fill="currentColor" stroke="none"/></svg>
  <svg viewBox="0 0 28 24" style="width:200px;top:58%;right:-40px;transform:rotate(14deg)" fill="none" stroke="currentColor" stroke-width="1"><path d="M4 13c0-3 6-9 14-9 4.5 0 7.5 4 9 9-1.5 5-4.5 9-9 9-8 0-14-6-14-9z"/><path d="M11 4.5C12 7 12.5 10 12.5 13c0 3-.5 6-1.5 8.5"/><path d="M4 13 0 8v10z"/></svg>
  <svg viewBox="0 0 22 24" style="width:160px;top:22%;right:3%;transform:rotate(-15deg)" fill="none" stroke="currentColor" stroke-width="1"><path d="M11 21c-4-5-7-8.5-7-12.5C4 5 7 3 11 3s7 2 7 5.5c0 4-3 7.5-7 12.5z"/><circle cx="9" cy="10" r=".7" fill="currentColor" stroke="none"/><circle cx="13" cy="11" r=".7" fill="currentColor" stroke="none"/><circle cx="11" cy="14.5" r=".7" fill="currentColor" stroke="none"/></svg>
  <svg viewBox="0 0 28 24" style="width:170px;top:12%;left:-20px;transform:rotate(-6deg)" fill="none" stroke="currentColor" stroke-width="1"><path d="M6 12c0-3.2 4.5-6 11-6 5 0 8 2.7 9 6-1 3.3-4 6-9 6-6.5 0-11-2.8-11-6z"/><circle cx="18" cy="10.5" r=".7" fill="currentColor" stroke="none"/><circle cx="14" cy="13" r=".7" fill="currentColor" stroke="none"/></svg>
</div>

<div class="wrap">
  <header>
    <div class="brand-row">
      <div style="width:40px;height:40px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 2px var(--gold);display:flex;align-items:center;justify-content:center;font-size:18px">🐟</div>
      <div class="eyebrow">Catálogo &middot; FrioCenter Pescados</div>
    </div>
    <h1>Catálogo de Fotos de Produtos</h1>
    <p class="subtitle">Acesse as fotos dos produtos pelo código e faça o download. Administradores podem cadastrar novos produtos.</p>
    <div class="mode-toggle">
      <button class="active" onclick="setMode('seller')">🔍 Vendedor — Buscar foto</button>
      <button onclick="setMode('admin')">🔒 Admin — Gerenciar catálogo</button>
    </div>
  </header>

  <!-- SELLER -->
  <div id="panel-seller" class="panel active">
    <div class="search-hero">
      <h2>Buscar foto por código</h2>
      <p>Digite o código exato do produto para localizar e baixar a foto.</p>
      <div class="search-row">
        <input type="text" id="sellerSearch" placeholder="Ex: 61314" onkeydown="if(event.key==='Enter')runSearch()">
        <button class="btn-search" onclick="runSearch()">Buscar</button>
      </div>
    </div>
    <div id="sellerAlert"></div>
    <div class="section-title">Todos os produtos</div>
    <div class="section-sub">Clique em qualquer produto para ver a foto em tamanho maior e baixar.</div>
    <div class="controls">
      <input type="text" id="gridSearch" placeholder="Filtrar por código ou nome..." oninput="renderGrid()">
    </div>
    <div class="grid" id="productGrid"></div>
  </div>

  <!-- ADMIN -->
  <div id="panel-admin" class="panel">
    <div class="stats">
      <div class="stat"><div class="n" id="statTotal">0</div><div class="l">Produtos cadastrados</div></div>
      <div class="stat"><div class="n" id="statFotos">0</div><div class="l">Com foto</div></div>
      <div class="stat"><div class="n" id="statSem">0</div><div class="l">Sem foto</div></div>
    </div>
    <div id="adminAlert"></div>
    <div class="section-title">Cadastrar novo produto</div>
    <div class="form-card">
      <div class="form-row">
        <label>Código do produto</label>
        <input type="text" id="inpCode" placeholder="Ex: 61314">
      </div>
      <div class="form-row">
        <label>Descrição do item</label>
        <input type="text" id="inpName" placeholder="Ex: BACALHAU DESSAL LOMBO SETE MARES CONG 12X800G">
      </div>
      <div class="form-row">
        <label>Foto do produto (opcional)</label>
        <div class="drop" id="dropZone">
          <input type="file" id="fileInput" accept="image/*" onchange="handleFile(this.files[0])">
          <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="opacity:.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"/></svg>
          <span id="dropLabel">Arraste a foto ou clique para selecionar</span>
          <img id="dropThumb" class="drop-thumb" alt="">
        </div>
      </div>
      <button class="btn-add" onclick="addProduct()">+ Adicionar produto</button>
    </div>
    <div class="section-title">Produtos cadastrados</div>
    <div class="section-sub">Clique no lixo para remover um item.</div>
    <div class="admin-list" id="adminList"></div>
  </div>
</div>

<!-- MODAL -->
<div class="modal-overlay" id="modalOverlay">
  <div class="modal">
    <img id="modalImg" class="modal-img" src="" alt="">
    <div class="modal-body">
      <div class="modal-code" id="modalCode"></div>
      <div class="modal-name" id="modalName"></div>
      <a id="btnDownload" class="btn-dl" href="#" download="">⬇ Baixar foto</a>
      <button class="btn-close" onclick="closeModal()">Fechar</button>
    </div>
  </div>
</div>

<footer>
  FrioCenter Pescados &middot; Catálogo de fotos de produtos &middot; Produtos adicionados pelo Admin ficam disponíveis enquanto a página estiver aberta neste navegador.
</footer>

<script>
const B64_IMG1 = "";
const B64_IMG2 = "";

function b64toDataUrl(b64) { return "data:image/jpeg;base64," + b64; }

function makeBlob(b64) {
  const bin = atob(b64);
  const arr = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) arr[i] = bin.charCodeAt(i);
  return new Blob([arr], {type:"image/jpeg"});
}

let PRODUCTS = [
  {code:"61314", name:"BACALHAU DESSAL LOMBO SETE MARES CONG 12X800G", b64:B64_IMG1, fname:"61314_bacalhau_sete_mares.jpg"},
  {code:"65415", name:"SAITHE FILE C/PELE CONG 1 A 1.5KG CX 10KG",    b64:B64_IMG2, fname:"65415_saithe_file.jpg"},
  {code:"43033", name:"LULA ANEIS CONGELADO AGRANEL CX 10KG",          b64:null,     fname:"43033_lula_aneis.jpg"},
];

let currentProduct = null;
let currentDataUrl  = null;

/* ---- UTIL ---- */
function showAlert(id, msg, type) {
  const el = document.getElementById(id);
  el.innerHTML = '<div class="alert ' + type + '">' + msg + '</div>';
  setTimeout(() => el.innerHTML = '', 3500);
}

/* ---- MODE ---- */
function setMode(m) {
  ['seller','admin'].forEach(p => {
    document.getElementById('panel-'+p).classList.toggle('active', p===m);
  });
  document.querySelectorAll('.mode-toggle button').forEach((b,i) =>
    b.classList.toggle('active', i===0 ? m==='seller' : m==='admin'));
  if (m === 'admin') renderAdmin();
}

/* ---- GRID (Seller) ---- */
function renderGrid() {
  const q = (document.getElementById('gridSearch').value || '').toLowerCase();
  const items = PRODUCTS.filter(p => !q || p.code.includes(q) || p.name.toLowerCase().includes(q));
  const el = document.getElementById('productGrid');
  if (!items.length) { el.innerHTML='<div class="empty">Nenhum produto encontrado.</div>'; return; }
  el.innerHTML = items.map(p => `
    <div class="card" onclick="openModal('${p.code}')">
      ${p.b64
        ? `<img src="data:image/jpeg;base64,${p.b64}" alt="${p.name}">`
        : `<div class="no-img">📷<span>Sem foto</span></div>`}
      <div class="card-body">
        <div class="card-code">#${p.code}</div>
        <div class="card-name">${p.name}</div>
        <div class="card-hint">${p.b64 ? '⬇ Clique para baixar' : 'Foto não disponível'}</div>
      </div>
    </div>`).join('');
}

/* ---- MODAL ---- */
function openModal(code) {
  const p = PRODUCTS.find(x => x.code === code);
  if (!p) return;
  currentProduct = p;
  document.getElementById('modalCode').textContent = 'Código: ' + p.code;
  document.getElementById('modalName').textContent = p.name;
  const imgEl = document.getElementById('modalImg');
  const btnDl = document.getElementById('btnDownload');
  if (p.b64) {
    imgEl.src = b64toDataUrl(p.b64);
    imgEl.style.display = 'block';
    // Use Blob URL for reliable download in all browsers
    const blob = makeBlob(p.b64);
    const blobUrl = URL.createObjectURL(blob);
    btnDl.href = blobUrl;
    btnDl.download = p.fname || p.code + '.jpg';
    btnDl.style.opacity = '1';
    btnDl.style.pointerEvents = 'auto';
  } else {
    imgEl.style.display = 'none';
    btnDl.href = '#';
    btnDl.download = '';
    btnDl.style.opacity = '0.4';
    btnDl.style.pointerEvents = 'none';
  }
  document.getElementById('modalOverlay').classList.add('open');
}

function closeModal() {
  document.getElementById('modalOverlay').classList.remove('open');
  // Revoke old blob URL to free memory
  const btn = document.getElementById('btnDownload');
  if (btn.href && btn.href.startsWith('blob:')) URL.revokeObjectURL(btn.href);
  currentProduct = null;
}

/* ---- SELLER SEARCH ---- */
function runSearch() {
  const q = document.getElementById('sellerSearch').value.trim();
  if (!q) { showAlert('sellerAlert','Digite um código para buscar.','err'); return; }
  const p = PRODUCTS.find(x => x.code === q);
  if (!p) { showAlert('sellerAlert','Código ' + q + ' não encontrado.','err'); return; }
  document.getElementById('sellerAlert').innerHTML = '';
  openModal(p.code);
}

/* ---- ADMIN ---- */
function renderAdmin() {
  const withImg = PRODUCTS.filter(p => p.b64).length;
  document.getElementById('statTotal').textContent = PRODUCTS.length;
  document.getElementById('statFotos').textContent = withImg;
  document.getElementById('statSem').textContent   = PRODUCTS.length - withImg;
  const el = document.getElementById('adminList');
  if (!PRODUCTS.length) { el.innerHTML='<div class="empty">Nenhum produto cadastrado.</div>'; return; }
  el.innerHTML = PRODUCTS.map(p => `
    <div class="admin-row">
      ${p.b64
        ? `<img src="data:image/jpeg;base64,${p.b64}" alt="">`
        : `<div class="no-thumb">📷</div>`}
      <div class="admin-info">
        <div class="c">#${p.code}</div>
        <div class="nm">${p.name}</div>
      </div>
      <button class="btn-del" onclick="deleteProduct('${p.code}')" title="Remover">🗑</button>
    </div>`).join('');
}

function deleteProduct(code) {
  if (!confirm('Remover ' + code + '?')) return;
  PRODUCTS = PRODUCTS.filter(p => p.code !== code);
  renderAdmin();
}

function handleFile(file) {
  if (!file) return;
  const r = new FileReader();
  r.onload = e => {
    currentDataUrl = e.target.result;
    const b64 = currentDataUrl.split(',')[1];
    const img = document.getElementById('dropThumb');
    img.src = currentDataUrl; img.style.display = 'block';
    document.getElementById('dropLabel').textContent = file.name;
    // Store b64 on a temp variable
    window._pendingB64 = b64;
  };
  r.readAsDataURL(file);
}

const dz = document.getElementById('dropZone');
dz.addEventListener('dragover', e => { e.preventDefault(); dz.classList.add('drag'); });
dz.addEventListener('dragleave', () => dz.classList.remove('drag'));
dz.addEventListener('drop', e => { e.preventDefault(); dz.classList.remove('drag'); if(e.dataTransfer.files[0]) handleFile(e.dataTransfer.files[0]); });

function addProduct() {
  const code = document.getElementById('inpCode').value.trim();
  const name = document.getElementById('inpName').value.trim();
  if (!code || !name) { showAlert('adminAlert','Preencha o código e a descrição.','err'); return; }
  if (PRODUCTS.find(p => p.code === code)) { showAlert('adminAlert','Código ' + code + ' já existe.','err'); return; }
  const b64 = window._pendingB64 || null;
  PRODUCTS.push({ code, name, b64, fname: code + '_' + name.toLowerCase().replace(/[^a-z0-9]+/g,'_').slice(0,30) + '.jpg' });
  document.getElementById('inpCode').value = '';
  document.getElementById('inpName').value = '';
  document.getElementById('dropLabel').textContent = 'Arraste a foto ou clique para selecionar';
  document.getElementById('dropThumb').style.display = 'none';
  document.getElementById('fileInput').value = '';
  window._pendingB64 = null;
  renderAdmin();
  renderGrid();
  showAlert('adminAlert','Produto adicionado com sucesso!','ok');
}

/* ---- INIT ---- */
document.getElementById('modalOverlay').addEventListener('click', e => { if(e.target.id==='modalOverlay') closeModal(); });
document.addEventListener('keydown', e => { if(e.key==='Escape') closeModal(); });
renderGrid();
</script>
</body>
</html>
